{
  "name": "autoventas-frontend",
  "version": "1.0.0",
  "description": "Interfaz web del CRM AutoVentas GT, S.A. (Angular 21 LTS)",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\""
  },
  "dependencies": {
    "@angular/common": "~21.2.26",
    "@angular/compiler": "~21.2.26",
    "@angular/core": "~21.2.26",
    "@angular/forms": "~21.2.26",
    "@angular/platform-browser": "~21.2.26",
    "@angular/router": "~21.2.26",
    "chart.js": "^4.6.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.30",
    "@angular/cli": "~21.2.30",
    "@angular/compiler-cli": "~21.2.26",
    "@eslint/js": "^9.39.5",
    "angular-eslint": "~21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^27.4.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.8"
  }
