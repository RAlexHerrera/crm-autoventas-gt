# =============================================================
# CRM AutoVentas GT — variables de entorno (copiar a .env)
# =============================================================

# ---- Base de datos MySQL ----
MYSQL_ROOT_PASSWORD=cambie_esta_clave_root
MYSQL_DATABASE=autoventas
MYSQL_USER=autoventas_app
MYSQL_PASSWORD=cambie_esta_clave_app
# Puerto publicado en el equipo anfitrión (para clientes como MySQL Workbench).
DB_PUERTO_HOST=3307

# ---- API (backend) ----
API_PUERTO_HOST=3000
# Mínimo 32 caracteres aleatorios. Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplace_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h
# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGIN=http://localhost:4200
# Límite de intentos fallidos de inicio de sesión por IP.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
# IVA en puntos básicos (1200 = 12 %, supuesto S8).
IVA_PUNTOS_BASICOS=1200
VIGENCIA_COTIZACION_DIAS=15

# ---- Frontend ----
WEB_PUERTO_HOST=4200
